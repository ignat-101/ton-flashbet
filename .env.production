# Production Environment Configuration for TON FlashBet
# Copy this file to .env and fill in the values

# Telegram Bot
BOT_TOKEN=your_bot_token_from_botfather
BOT_USERNAME=FlashBetTON_bot
TMA_URL=https://your-app.onrender.com/

# TON Configuration
BOT_WALLET_ADDRESS=your_ton_wallet_address
TON_API_KEY=your_toncenter_api_key
TON_API_ENDPOINT=https://toncenter.com/api/v2/jsonRPC

# Flask
FLASK_SECRET=generate_a_strong_random_string_here_min_32_chars
DEBUG=false

# Security
ALLOWED_HOSTS=your-app.onrender.com,localhost,127.0.0.1
CSRF_ENABLED=true

# Rate Limiting
RATELIMIT_STORAGE_URL=memory://
RATELIMIT_DEFAULT=100 per hour

# Logging
LOG_LEVEL=INFO
LOG_FILE=/tmp/ton-flashbet.log

# Database (for future SQLite migration)
# DB_PATH=/app/data/flashbet.db
# DB_BACKUP_PATH=/app/backups
